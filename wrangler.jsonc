{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seedgression-phase1",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "731001", "simple": { "limit": 10, "period": 60 } },
    { "name": "EMAIL_LIMITER", "namespace_id": "731002", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": {
    "CONTACT_ENABLED": "false",
    "RECIPIENT_EMAILS": "",
    "RESEND_FROM_EMAIL": "",
    "REPLY_TO_EMAIL": ""
  },
  "observability": { "enabled": true }
}
