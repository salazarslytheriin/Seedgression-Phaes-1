{
  "name": "seedgression-phase1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Seedgression Phase 1: static website and Cloudflare Worker",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && wrangler deploy --dry-run --outdir .build",
    "deploy": "npm run check && wrangler deploy",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "wrangler": "4.131.1"
  }
}
